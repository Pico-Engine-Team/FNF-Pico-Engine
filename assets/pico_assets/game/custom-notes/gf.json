{
	"version": "1.1.0",
	"name": "GF Notes",
	"fallback": null,
	"assets": {
		"note": {
			 "assetPath": "ui/notes/GF-Notes",
			"scale": 0.7,
			"data": {
				"left": {"prefix": "purple0", "frameRate": 24, "looped": true},
				"down": {"prefix": "blue0", "frameRate": 24, "looped": true},
				"up": {"prefix": "green0", "frameRate": 24, "looped": true},
				"right": {"prefix": "red0", "frameRate": 24, "looped": true},
				"leftHoldEnd": {"prefix": "pruple end hold", "frameRate": 24, "looped": true},
				"leftHold": {"prefix": "purple hold piece", "frameRate": 24, "looped": true},
				"downHoldEnd": {"prefix": "blue hold end", "frameRate": 24, "looped": true},
				"downHold": {"prefix": "blue hold piece", "frameRate": 24, "looped": true},
				"upHoldEnd": {"prefix": "green hold end", "frameRate": 24, "looped": true},
				"upHold": {"prefix": "green hold piece", "frameRate": 24, "looped": true},
				"rightHoldEnd": {"prefix": "red hold end", "frameRate": 24, "looped": true},
				"rightHold": {"prefix": "red hold piece", "frameRate": 24, "looped": true},
				"leftStatic": {"prefix": "arrowLEFT", "frameRate": 24, "looped": true},
				"leftPress": {"prefix": "left press", "frameRate": 24, "looped": false},
				"leftConfirm": {"prefix": "left confirm", "frameRate": 24, "looped": false},
				"downStatic": {"prefix": "arrowDOWN", "frameRate": 24, "looped": true},
				"downPress": {"prefix": "down press", "frameRate": 24, "looped": false},
				"downConfirm": {"prefix": "down confirm", "frameRate": 24, "looped": false},
				"upStatic": {"prefix": "arrowUP", "frameRate": 24, "looped": true},
				"upPress": {"prefix": "up press", "frameRate": 24, "looped": false},
				"upConfirm": {"prefix": "up confirm", "frameRate": 24, "looped": false},
				"rightStatic": {"prefix": "arrowRIGHT", "frameRate": 24, "looped": true},
				"rightPress": {"prefix": "right press", "frameRate": 24, "looped": false},
				"rightConfirm": {"prefix": "right confirm", "frameRate": 24, "looped": false}
			}
		},
		"noteSplash": {
			"assetPath": "noteSplashes/noteSplashes-vanilla"
		},
		"holdNoteCover": {
			"offsets": [-110, -100],
			"scale": 1.0,
			"centerOnStrum": false,
			"data": {
				"enabled": true,
				"left": {
					"assetPath": "holdCovers/default/holdCoverPurple",
					"start": {"prefix": "holdCoverStartPurple", "frameRate": 24, "looped": false},
					"hold": {"prefix": "holdCoverPurple", "frameRate": 24, "looped": true},
					"end": {"prefix": "holdCoverEndPurple", "frameRate": 24, "looped": false}
				},
				"down": {
					"assetPath": "holdCovers/default/holdCoverBlue",
					"start": {"prefix": "holdCoverStartBlue", "frameRate": 24, "looped": false},
					"hold": {"prefix": "holdCoverBlue", "frameRate": 24, "looped": true},
					"end": {"prefix": "holdCoverEndBlue", "frameRate": 24, "looped": false}
				},
				"up": {
					"assetPath": "holdCovers/default/holdCoverGreen",
					"start": {"prefix": "holdCoverStartGreen", "frameRate": 24, "looped": false},
					"hold": {"prefix": "holdCoverGreen", "frameRate": 24, "looped": true},
					"end": {"prefix": "holdCoverEndGreen", "frameRate": 24, "looped": false}
				},
				"right": {
					"assetPath": "holdCovers/default/holdCoverRed",
					"start": {"prefix": "holdCoverStartRed", "frameRate": 24, "looped": false},
					"hold": {"prefix": "holdCoverRed", "frameRate": 24, "looped": true},
					"end": {"prefix": "holdCoverEndRed", "frameRate": 24, "looped": false}
				}
			}
		}
	},
	"allowRGB": false,
	"allowPixel": false
}
